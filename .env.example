# PostgreSQL - Base de datos principal
POSTGRES_DB=stockflow_db
POSTGRES_USER=stockflow_user
POSTGRES_PASSWORD=change_me

# Conexion a la base de datos principal (ejecucion local)
DATABASE_URL=postgresql+psycopg://stockflow_user:change_me@localhost:5432/stockflow_db

# Conexion a la base de datos exclusiva para tests
TEST_DATABASE_URL=postgresql+psycopg://stockflow_user:change_me@localhost:5432/stockflow_test_db

# Conexion a la base de datos desde Docker Compose (host "db")
DATABASE_URL_DOCKER=postgresql+psycopg://stockflow_user:change_me@db:5432/stockflow_dbstockflow_test_db